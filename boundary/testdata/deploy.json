{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowIAMRead",
      "Effect": "Allow",
      "Action": [
        "iam:Get*",
        "iam:List*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowCreateStackRoles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:PutRolePermissionsBoundary"
      ],
      "Resource": "arn:part:iam::*:role/grun-*",
      "Condition": {
        "ArnLike": {
          "iam:PermissionsBoundary": "arn:part:iam::*:policy/bound@tech-grun"
        }
      }
    },
    {
      "Sid": "AllowManageStackRoles",
      "Effect": "Allow",
      "Action": [
        "iam:PutRolePolicy",
        "iam:AttachRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:DetachRolePolicy",
        "iam:DeleteRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateRole",
        "iam:UpdateRoleDescription",
        "iam:UpdateAssumeRolePolicy"
      ],
      "Resource": "arn:part:iam::*:role/grun-*"
    },
    {
      "Sid": "AllowPassStackAndBootstrapRoles",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": [
        "arn:part:iam::*:role/grun-*",
        "arn:part:iam::*:role/cdk-hnb659fds-*"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "apigateway.amazonaws.com",
            "cloudformation.amazonaws.com",
            "codebuild.amazonaws.com",
            "ecs-tasks.amazonaws.com",
            "events.amazonaws.com",
            "lambda.amazonaws.com",
            "scheduler.amazonaws.com",
            "states.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "AllowServiceLinkedRoles",
      "Effect": "Allow",
      "Action": "iam:CreateServiceLinkedRole",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "iam:AWSServiceName": [
            "codestar-notifications.amazonaws.com",
            "ecs.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "AllowAssumeBootstrapRoles",
      "Effect": "Allow",
      "Action": "sts:AssumeRole",
      "Resource": "arn:part:iam::*:role/cdk-hnb659fds-*"
    },
    {
      "Sid": "AllowStackServices",
      "Effect": "Allow",
      "Action": [
        "apigateway:*",
        "cloudformation:*",
        "cloudwatch:*",
        "codebuild:*",
        "codestar-notifications:*",
        "dynamodb:*",
        "ecs:*",
        "events:*",
        "lambda:*",
        "logs:*",
        "scheduler:*",
        "secretsmanager:*",
        "sns:*",
        "sqs:*",
        "states:*"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowEC2SecurityGroupsAndLookups",
      "Effect": "Allow",
      "Action": [
        "ec2:Describe*",
        "ec2:CreateSecurityGroup",
        "ec2:DeleteSecurityGroup",
        "ec2:AuthorizeSecurityGroupIngress",
        "ec2:AuthorizeSecurityGroupEgress",
        "ec2:RevokeSecurityGroupIngress",
        "ec2:RevokeSecurityGroupEgress",
        "ec2:ModifySecurityGroupRules",
        "ec2:UpdateSecurityGroupRuleDescriptionsIngress",
        "ec2:UpdateSecurityGroupRuleDescriptionsEgress",
        "elasticloadbalancing:Describe*",
        "route53:Get*",
        "route53:List*",
        "acm:DescribeCertificate",
        "acm:GetCertificate",
        "acm:ListCertificates",
        "acm:ListTagsForCertificate"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowEC2SecurityGroupTags",
      "Effect": "Allow",
      "Action": [
        "ec2:CreateTags",
        "ec2:DeleteTags"
      ],
      "Resource": "arn:part:ec2:*:*:security-group/*"
    },
    {
      "Sid": "AllowKMSUse",
      "Effect": "Allow",
      "Action": [
        "kms:Encrypt",
        "kms:Decrypt",
        "kms:ReEncrypt*",
        "kms:GenerateDataKey*",
        "kms:DescribeKey",
        "kms:Sign",
        "kms:Verify",
        "kms:GetPublicKey"
      ],
      "Resource": "*"
    },
    {
      "Sid": "AllowKMSGrantsForAWSResources",
      "Effect": "Allow",
      "Action": [
        "kms:CreateGrant",
        "kms:ListGrants",
        "kms:RetireGrant"
      ],
      "Resource": "*",
      "Condition": {
        "Bool": {
          "kms:GrantIsForAWSResource": "true"
        }
      }
    },
    {
      "Sid": "AllowECRRepositories",
      "Effect": "Allow",
      "Action": "ecr:*",
      "Resource": [
        "arn:part:ecr:*:*:repository/grun-*",
        "arn:part:ecr:*:*:repository/cdk-hnb659fds-container-assets-*"
      ]
    },
    {
      "Sid": "AllowECRToken",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "AllowBootstrapAssets",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject*",
        "s3:GetBucket*",
        "s3:GetEncryptionConfiguration",
        "s3:List*",
        "s3:PutObject*",
        "s3:DeleteObject*",
        "s3:Abort*"
      ],
      "Resource": [
        "arn:part:s3:::cdk-hnb659fds-assets-*",
        "arn:part:s3:::cdk-hnb659fds-assets-*/*"
      ]
    },
    {
      "Sid": "AllowStackBuckets",
      "Effect": "Allow",
      "Action": "s3:*",
      "Resource": [
        "arn:part:s3:::grun-*",
        "arn:part:s3:::grun-*/*"
      ]
    },
    {
      "Sid": "AllowReadBuckets",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion",
        "s3:GetBucketLocation",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:part:s3:::example-truststore",
        "arn:part:s3:::example-truststore/*"
      ]
    },
    {
      "Sid": "AllowSSMRead",
      "Effect": "Allow",
      "Action": [
        "ssm:GetParameter",
        "ssm:GetParameters",
        "ssm:GetParametersByPath"
      ],
      "Resource": [
        "arn:part:ssm:*:*:parameter/cdk-bootstrap/hnb659fds/*",
        "arn:part:ssm:*:*:parameter/example/runners/*"
      ]
    },
    {
      "Sid": "AllowSSMDescribe",
      "Effect": "Allow",
      "Action": "ssm:DescribeParameters",
      "Resource": "*"
    },
    {
      "Sid": "AllowStackBudgets",
      "Effect": "Allow",
      "Action": "budgets:*",
      "Resource": "arn:part:budgets::*:budget/grun-*"
    },
    {
      "Sid": "DenyReadSecretValues",
      "Effect": "Deny",
      "Action": [
        "secretsmanager:GetSecretValue",
        "secretsmanager:BatchGetSecretValue"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyOrganizationAndBilling",
      "Effect": "Deny",
      "Action": [
        "organizations:*",
        "account:*",
        "billing:*",
        "aws-portal:*",
        "payments:*"
      ],
      "Resource": "*"
    }
  ]
}
